# Database Configuration
DATABASE_URL=postgresql://h4wk5int:h4wk5int_password@localhost:5432/h4wk5int

# Security Keys (Change these in production!)
SECRET_KEY=h4wk5int_secret_key_change_in_production
JWT_SECRET=h4wk5int_jwt_secret_change_in_production

# Redis Configuration
REDIS_URL=redis://localhost:6379

# Tor Configuration
TOR_PROXY=socks5://127.0.0.1:9050
USE_TOR=true

# Report Storage
REPORTS_PATH=./reports/generated

# OSINT API Keys (Optional - Add your own keys)
# SHODAN_API_KEY=your_shodan_api_key
